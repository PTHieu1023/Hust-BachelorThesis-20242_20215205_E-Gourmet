// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


model User {
  id               Int       @id
  email            String    @unique
  name             String
  username         String    @unique
  age              Int?
  eatingFrequency  Int ?      // tần suất đi ăn nhà hàng
  budget           Float?     // ngân sách trung bình
  preferredCuisines UserCuisine[]
  reviews          Review[]
}

model Cuisine {
  id          Int       @id
  name        String
  parent      Cuisine?  @relation("CuisineHierarchy", fields: [parentId], references: [id])
  parentId    Int?
  children    Cuisine[] @relation("CuisineHierarchy")
  level       Int
  childCount  Int       @default(0)
  weight      Float
  dishTypes   Dish[]
  userPrefs   UserCuisine[]
}

model UserCuisine {
  id        Int     @id
  user      User    @relation(fields: [userId], references: [id])
  userId    Int
  cuisine   Cuisine @relation(fields: [cuisineId], references: [id])
  cuisineId Int
}

model Restaurant {
  id        Int       @id
  name      String
  address   String
  owner     String
  menuItems Dish[]
  posts     Post[]
}

model Dish {
  id                 Int       @id
  name               String
  price              Float
  cuisine            Cuisine   @relation(fields: [cuisineId], references: [id])
  cuisineId          Int
  restaurant         Restaurant @relation(fields: [restaurantId], references: [id])
  restaurantId       Int
  reviews            Review[]
}

model Review {
  id          Int        @id
  rating      Int
  comment     String
  createdAt   DateTime   @default(now())
  user        User       @relation(fields: [userId], references: [id])
  userId      Int
  dish        Dish       @relation(fields: [dishId], references: [id])
  dishId      Int
}

model Post {
  id           Int        @id
  content      String
  createdAt    DateTime   @default(now())
  restaurant   Restaurant? @relation(fields: [restaurantId], references: [id])
  restaurantId Int?
  userId       Int?
}


